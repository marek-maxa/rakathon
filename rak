#!/usr/bin/env python3
"""Small, dependency-free workspace shortcuts. No autonomous orchestration."""

import argparse
import os
from pathlib import Path
import re
import shlex
import shutil
import subprocess
import sys

ROOT = Path(__file__).resolve().parent


def run(command, *, capture=False):
    if not capture:
        print(f"+ {shlex.join(map(str, command))}", flush=True)
    return subprocess.run(
        command, cwd=ROOT, check=True, text=True, capture_output=capture
    ).stdout


def git(*args):
    return run(["git", "--no-optional-locks", *args], capture=True).strip()


def new_task(slug, open_editor=False):
    if len(slug) > 60 or not re.fullmatch(r"[a-z0-9]+(?:-[a-z0-9]+)*", slug):
        raise ValueError("Task name: 1–60 lowercase letters/digits, separated by hyphens.")
    if Path(git("rev-parse", "--absolute-git-dir")).resolve() != Path(
        git("rev-parse", "--path-format=absolute", "--git-common-dir")
    ).resolve():
        raise ValueError("Create tasks from the primary checkout, not a task worktree.")
    if git("symbolic-ref", "--short", "HEAD") != "main":
        raise ValueError("The primary checkout must be on main before creating a task.")
    try:
        git("rev-parse", "--verify", "HEAD")
    except subprocess.CalledProcessError as error:
        raise ValueError("No initial commit. Review and commit the workspace first; see README.") from error
    if git("status", "--porcelain=v1", "--untracked-files=all"):
        raise ValueError("Primary checkout has changes. Review/preserve them before creating a task.")
    parent = ROOT / ".worktrees"
    destination = parent / slug
    if parent.is_symlink() or os.path.lexists(destination):
        raise ValueError("Worktree path exists or .worktrees is a symlink; nothing was replaced.")
    try:
        git("check-ignore", "--quiet", "--no-index", f".worktrees/{slug}")
    except subprocess.CalledProcessError as error:
        raise ValueError(".worktrees/ must be ignored by Git before creating tasks.") from error
    if open_editor and not shutil.which("code"):
        raise ValueError("VS Code command 'code' is missing; omit --open.")
    parent.mkdir(exist_ok=True)
    run(["git", "worktree", "add", "-b", f"task/{slug}", str(destination), "main"])
    print(f"Worktree ready. In your terminal run:\n  cd -- {shlex.quote(str(destination))}", flush=True)
    if open_editor:
        run(["code", "--new-window", str(destination)])


def start_agent(tool):
    if not git("symbolic-ref", "--short", "HEAD").startswith("task/"):
        raise ValueError("Start a writer on a task/<name> branch; create/select a task worktree first.")
    if not shutil.which(tool):
        raise ValueError(f"{tool} is missing from PATH. Nothing was installed.")
    # Replace this launcher; use native interactive permissions/authentication.
    print(f"Starting {tool} in {ROOT}. One writer per checkout; no other agents are started.", flush=True)
    os.chdir(ROOT)
    os.execvp(tool, [tool])


def main(argv=None):
    parser = argparse.ArgumentParser(
        prog="uv run ./rak", description="Rakathon workspace shortcuts (no external dependencies)."
    )
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("doctor", help="Check local tools and workspace; no model requests")
    commands.add_parser("status", help="Show Git, worktrees, task board and usage instructions")
    commands.add_parser("check", help="Run doctor and workspace utility tests; not application tests")
    task = commands.add_parser("task", help="Create task/NAME in .worktrees/NAME from clean main")
    task.add_argument("name", help="Example: data-contract")
    task.add_argument("--open", action="store_true", help="Also open a new VS Code window")
    agent = commands.add_parser("agent", help="Start one native CLI in this task checkout")
    agent.add_argument("tool", choices=["codex", "claude", "agy"])
    args = parser.parse_args(argv)
    try:
        if args.command in {"doctor", "status"}:
            run(["bash", f"scripts/{args.command}.sh"])
        elif args.command == "check":
            run(["bash", "scripts/doctor.sh"])
            run([sys.executable, "-m", "unittest", "discover", "-s", "tests", "-v"])
        elif args.command == "task":
            new_task(args.name, args.open)
        elif args.command == "agent":
            start_agent(args.tool)
    except (ValueError, OSError) as error:
        print(f"ERROR: {error}", file=sys.stderr)
        return 1
    except subprocess.CalledProcessError as error:
        if error.stderr:
            print(error.stderr.strip(), file=sys.stderr)
        print(f"ERROR: command failed ({error.returncode}): {shlex.join(map(str, error.cmd))}", file=sys.stderr)
        return error.returncode
    except KeyboardInterrupt:
        return 130
    return 0


if __name__ == "__main__":
    sys.exit(main())
