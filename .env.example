# Web access
MEDDI_BASIC_AUTH_USERNAME=
MEDDI_BASIC_AUTH_PASSWORD=
FLASK_SECRET_KEY=

# OpenAI-compatible Chat Completions provider; must support structured outputs.
MEDDI_LLM_API_KEY=
MEDDI_LLM_BASE_URL=https://api.openai.com/v1/
MEDDI_LLM_MODEL=
# Authorization for Bearer tokens; api-key for Azure gateways.
MEDDI_LLM_KEY_HEADER=Authorization

# Optional. Defaults to data/; use a persistent directory when hosting the demo.
# MEDDI_DATA_DIR=/path/to/persistent/data

# Optional SMTP notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
